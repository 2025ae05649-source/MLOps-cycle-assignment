{
  "title": "Heart Disease API",
  "uid": "heart-api",
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "schemaVersion": 39,
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Total requests",
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum(api_requests_total)", "refId": "A" }]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Predictions by class (0 = no disease, 1 = disease)",
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum by (prediction) (predictions_total)", "legendFormat": "class {{prediction}}", "refId": "A" }]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Errors (status 4xx/5xx)",
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum(api_requests_total{status=~\"4..|5..\"}) or vector(0)", "refId": "A" }]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Requests per second by endpoint",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum by (endpoint) (rate(api_requests_total[1m]))", "legendFormat": "{{endpoint}}", "refId": "A" }]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Average latency (seconds)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "rate(api_request_latency_seconds_sum[1m]) / rate(api_request_latency_seconds_count[1m])", "legendFormat": "{{endpoint}}", "refId": "A" }]
    }
  ]
}
